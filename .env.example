# PostgreSQL connection string.
# Free hosted options that work well here: Neon (neon.tech) or Supabase (supabase.com).
DATABASE_URL="postgresql://user:password@host:5432/kennel?sslmode=require"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run db:seed` to create the first admin login.
SEED_ADMIN_EMAIL="admin@yourkennel.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Kennel Admin"

# Vercel Blob — powers drag-and-drop photo uploads in the admin dashboard.
# Get this from your Vercel project: Storage tab -> Create Database -> Blob
# -> copy the "BLOB_READ_WRITE_TOKEN" it gives you.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
